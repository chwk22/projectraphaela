{
  "name": "raphaela-project",
  "version": "1.0.0",
  "private": true,
  "description": "Offline sunrise and sunset planning for Australia.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test \"src/**/*.test.js\"",
    "test:watch": "node --test --watch \"src/**/*.test.js\"",
    "typecheck": "tsc --noEmit --allowJs --checkJs src/lib/solar.js",
    "cap:sync": "vite build && cap sync",
    "ios": "vite build && cap sync ios && cap open ios",
    "android": "vite build && cap sync android && cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/geolocation": "^8.2.4",
    "@capacitor/ios": "^8.6.0",
    "lucide-react": "^0.383.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^5.5.0",
    "vite": "^8.3.0"
  },
  "browserslist": [
    "defaults",
    "safari >= 14",
    "firefox >= 90"
  ]
}
